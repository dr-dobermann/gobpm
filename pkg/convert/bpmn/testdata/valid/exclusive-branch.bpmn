<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <bpmn:process id="exclusive-fixture" name="Exclusive branch" isExecutable="true">
    <bpmn:startEvent id="start"/>
    <bpmn:userTask id="review" name="Review"/>
    <bpmn:exclusiveGateway id="decision" gatewayDirection="Diverging" default="rejected"/>
    <bpmn:endEvent id="approved-end"/>
    <bpmn:endEvent id="rejected-end"/>
    <bpmn:sequenceFlow id="to-review" sourceRef="start" targetRef="review"/>
    <bpmn:sequenceFlow id="to-decision" sourceRef="review" targetRef="decision"/>
    <bpmn:sequenceFlow id="approved" sourceRef="decision" targetRef="approved-end">
      <bpmn:conditionExpression id="approved-condition" language="text/plain">approved == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="rejected" sourceRef="decision" targetRef="rejected-end"/>
  </bpmn:process>
</bpmn:definitions>
